\@writefile{lof}{\contentsline {figure}{\numberline {6.1}{\ignorespaces Log-log degree distribution of the Barab\'{a}si--Albert model aggregated over 200 independent runs ($n=2000$, $m=2$). The dashed line is an OLS fit to $\log P(k)$ vs $\log k$ for $k \in [2, 50]$; the dash-dotted line is the theoretical curve $P(k) = 2m^2 k^{-3}$. The fitted slope is $-2.73$ ($\hat  \tau \approx 2.73$, $R^2 = 0.998$), consistent with the asymptotic prediction $\tau = 3$ given the finite-$n$ truncation of the tail.}}{28}{figure.caption.21}\protected@file@percent }
\newlabel{fig:ba_loglog}{{6.1}{28}{Log-log degree distribution of the Barab\'{a}si--Albert model aggregated over 200 independent runs ($n=2000$, $m=2$). The dashed line is an OLS fit to $\log P(k)$ vs $\log k$ for $k \in [2, 50]$; the dash-dotted line is the theoretical curve $P(k) = 2m^2 k^{-3}$. The fitted slope is $-2.73$ ($\hat \tau \approx 2.73$, $R^2 = 0.998$), consistent with the asymptotic prediction $\tau = 3$ given the finite-$n$ truncation of the tail}{figure.caption.21}{}}
