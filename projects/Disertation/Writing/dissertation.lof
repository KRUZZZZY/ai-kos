\contentsline {figure}{\numberline {4.1}{\ignorespaces Empirical degree distribution of the Erd\H {o}s--R\'{e}nyi model averaged over 1115 simulation runs ($n = 2000$, $\lambda = 8.00$) compared with the theoretical Poisson distribution.}}{18}{figure.caption.8}%
\contentsline {figure}{\numberline {4.2}{\ignorespaces ER($n = 1000, p$) metrics vs $p$ over 999 simulated runs with $p$ values 0.0005, 0.0008, 0.0009,0.0010, 0.0011, 0.0012, 0.0015, 0.0020, 0.0030}}{20}{figure.caption.14}%
\contentsline {figure}{\numberline {4.3}{\ignorespaces Single-instance Erd\H {o}s--R\'{e}nyi graph ($n=80$, $p=0.07$). Roughly uniform node sizes are consistent with the Poisson degree distribution (right), overlaid with the theoretical Poisson($\lambda = 5.95$) curve.}}{21}{figure.caption.15}%
\addvspace {10\p@ }
\contentsline {figure}{\numberline {5.1}{\ignorespaces Normalised clustering $C(\beta )/C(0)$ and average path length $L(\beta )/L(0)$ against rewiring probability $\beta $ on a logarithmic scale. The shaded region marks the small-world window.}}{24}{figure.caption.17}%
\contentsline {figure}{\numberline {5.2}{\ignorespaces Network metrics of the Watts--Strogatz model as a function of rewiring probability $\beta $ ($n=500$, $k=8$).}}{25}{figure.caption.18}%
\contentsline {figure}{\numberline {5.3}{\ignorespaces Watts--Strogatz graphs ($n=80$, $k=4$) at three values of rewiring probability, illustrating the lattice-to-random transition. Clustering $C$ and path length $L$ are shown above each panel.}}{26}{figure.caption.19}%
\contentsline {figure}{\numberline {5.4}{\ignorespaces Single-instance Watts--Strogatz graph ($n=80$, $k=6$, $\beta =0.1$), showing tightly clustered local neighbourhoods with a narrow degree distribution centred on $k=6$.}}{26}{figure.caption.20}%
\addvspace {10\p@ }
\contentsline {figure}{\numberline {6.1}{\ignorespaces Log-log degree distribution of the Barab\'{a}si--Albert model aggregated over 200 independent runs ($n=2000$, $m=2$). The dashed line is an OLS fit to $\log P(k)$ vs $\log k$ for $k \in [2, 50]$; the dash-dotted line is the theoretical curve $P(k) = 2m^2 k^{-3}$. The fitted slope is $-2.73$ ($\hat \tau \approx 2.73$, $R^2 = 0.998$), consistent with the asymptotic prediction $\tau = 3$ given the finite-$n$ truncation of the tail.}}{28}{figure.caption.21}%
\contentsline {figure}{\numberline {6.2}{\ignorespaces Four network metrics of the Barab\'{a}si--Albert model across values of attachment parameter $m$ ($n=500$, mean $\pm $ std).}}{30}{figure.caption.22}%
\contentsline {figure}{\numberline {6.3}{\ignorespaces Single BA graph instance ($n=80$, $m=2$).}}{31}{figure.caption.23}%
